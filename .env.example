# Environment variables template
# Copy this file to .env and fill in your values

FLASK_ENV=development
FLASK_DEBUG=True
DEBUG=True
PORT=5000

# Database
DEV_DATABASE_URL=sqlite:///app.db
DATABASE_URL=sqlite:///app.db

